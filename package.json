{
  "name": "mvp_encuentrojuvenil",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client && npm run build:server",
    "build:render": "npm install && cd server && npm install && npx prisma db push && npm run build && cd ../client && npm install && npm run build",
    "start": "node server/dist/index.js",
    "prod": "npm run build && node server/dist/index.js",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:5173",
    "tunnel:prod": ".\\cloudflared.exe tunnel --url http://localhost:4000"
  }
